migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
# Contains symlinks that don't survive being zipped and extracted somewhere
# else — a stale one blocked `flutter pub get` from recreating it after
# exactly that happened once already.
**/ephemeral/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# /build/ above only matches the top-level Flutter build output — platform
# subprojects (android/build, ios/build, …) have their own, which slipped
# through and got a Gradle report committed once already.
**/build/
/coverage/
mapillary.local.json
/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
